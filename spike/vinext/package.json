{
  "name": "lexema-vinext-spike",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to \"$PWD/.wrangler/state\"",
    "db:seed": "wrangler d1 execute lexema_spike --local --file=./db/seed.sql",
    "proof": "./scripts/proof.sh",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
