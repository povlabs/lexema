{
  "name": "lexema-italian-validation-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "prepare": "sh tools/install-git-hooks.sh",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:root && pnpm run test:web",
    "test:root": "node --import tsx --test 'test/*.test.ts'",
    "test:web": "TSX_TSCONFIG_PATH=web/tsconfig.json node --import tsx --experimental-test-module-mocks --test 'web/test/*.test.ts' 'web/test/*.test.tsx'",
    "test:integration": "node --import tsx --test test/integration/adapter-fixtures.test.ts",
    "test:definition-loss": "python3 tools/definition_loss.py verify && python3 test/definition-loss.py",
    "validate": "tsx src/cli.ts validate",
    "seed:dev": "tsx src/import/seedDev.ts",
    "normalize:source-text": "tsx src/import/normalizeSourceTextCli.ts",
    "hide:records": "tsx src/import/hideRecordsCli.ts",
    "correct:records": "tsx src/import/correctRecordsCli.ts",
    "load:page-entries": "tsx src/import/loadPageEntriesCli.ts",
    "update:auto": "tsx src/update/updateCli.ts auto",
    "update:upgrade": "tsx src/update/updateCli.ts upgrade",
    "update:diff": "tsx src/update/updateCli.ts diff",
    "update:select": "tsx src/update/updateCli.ts select",
    "update:apply": "tsx src/update/updateCli.ts apply",
    "deploy:dictionary": "tsx src/deploy/deployCli.ts",
    "preview:slice": "tsx src/deploy/sliceCli.ts",
    "release:monthly": "tsx src/release/releaseCli.ts",
    "db:generate": "drizzle-kit generate",
    "db:check-d1": "tsx src/db/app/sampleRowsCli.ts",
    "api-key": "tsx src/api/keyCli.ts",
    "plan": "tsx src/billing/planCli.ts",
    "report": "tsx src/readerReport/reportCli.ts",
    "measure:recovery": "tsx src/import/measureRecovery.ts",
    "measure:quality": "tsx src/import/measureQuality.ts",
    "measure:section-language": "tsx src/import/measureSectionLanguage.ts",
    "bench:lookup": "tsx src/bench/lookupBenchCli.ts",
    "measure:bare-spellings": "tsx src/lookup/measureBareSpellings.ts",
    "measure:plural-gloss": "tsx src/import/measurePluralGloss.ts",
    "measure:page-entry-fields": "tsx src/import/measurePageEntryFields.ts"
  },
  "devDependencies": {
    "@kampus/fabrika-cli": "catalog:",
    "@types/node": "catalog:node22",
    "drizzle-kit": "catalog:",
    "lefthook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/stripe": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "stripe": "catalog:"
  }
}
