{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vinext/types", "./worker-configuration.d.ts"],
    "paths": {
      "@/*": ["./*"],
      "@lexema/lookup/*": ["../src/lookup/*"],
      "@lexema/italian/*": ["../src/italian/*"],
      "@lexema/source/*": ["../src/source/*"],
      "@lexema/api/*": ["../src/api/*"],
      "@lexema/accounts/*": ["../src/accounts/*"],
      "@lexema/db/*": ["../src/db/*"],
      "@lexema/billing/*": ["../src/billing/*"]
    }
  },
  "include": ["app", "builds", "components", "lib", "worker", "test", "vite.config.ts", "worker-configuration.d.ts", "../src/lookup", "../src/italian", "../src/api", "../src/accounts", "../src/db/app"]
}
