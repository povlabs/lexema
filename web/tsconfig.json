{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "./worker-configuration.d.ts"],
    "paths": {
      "@lexema/lookup/*": ["../src/lookup/*"],
      "@lexema/italian/*": ["../src/italian/*"]
    }
  },
  "include": ["app", "test", "vite.config.ts", "worker-configuration.d.ts", "../src/lookup", "../src/italian"]
}
