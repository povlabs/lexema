{
  "name": "@lexema/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to \"$PWD/.wrangler/state\"",
    "deploy:production": "CLOUDFLARE_ENV=production vinext build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:workers-builds": "node builds/production.ts",
    "preview:prepare": "node builds/preview.ts",
    "typecheck": "wrangler types --env-file typecheck.env && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@cf-wasm/resvg": "catalog:",
    "@cf-wasm/satori": "catalog:",
    "@vinext/cloudflare": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "vinext": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
