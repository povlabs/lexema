{
  "$schema": "./.fabrika.schema.json",
  // A diff under these roots owes a governance verdict. Wider than
  // .github/CODEOWNERS since #532: CODEOWNERS keeps only the paths that need
  // Huey's sign-off. Must include this file, or fabrika refuses to load.
  "governedRoots": [
    ".decisions/",
    ".claude/",
    ".github/",
    ".fabrika.jsonc",
    "AGENTS.md",
    "design-system-manifest.md",
    "lefthook.yml"
  ],
  // Names that mean something only here; the portability guard keeps them out
  // of Fabrika's own shipped text.
  "portability": { "repoNames": ["lexema", "hueypov", "povlabs"] },
  // At most two claimed issue lanes at once; `lane open` and `lane emit`
  // refuse a third.
  "laneConcurrencyCap": 2,
  // Epic runs: merge main into the assembly branch before the tail review and
  // before each child is dispatched off it.
  "assemblyRefresh": { "onReview": "on", "onDispatch": "on" },
  // Epic runs: replay a colliding child onto the assembly tip and send it back
  // for one review round, instead of refusing the merge.
  "assemblyReplay": { "onCollision": "on" },
  // Epic runs: count machinery laps apart from the repair budget. Read when a
  // lane is emitted, so lanes already on disk keep the old count.
  "machineryLaps": { "onEmit": "on" },
  // If CODEOWNERS cannot be read, refuse. Nothing in Fabrika 0.10.0 reads this
  // key; it is set strict so it cannot drift if it is wired up again.
  "unreadableCodeowners": "refuse",
  "uiSurfaces": [
    {
      "name": "web",
      // Covers fonts as well as app code. web/test/fixture.ts raises the UI
      // class; only test filenames are excluded. Route pixel-neutral edits
      // with review-ui route instead of capturing them. Both local D1s, the
      // dictionary (DB) and the app database (APP_DB, ADR 0018), are seeded
      // once and reused: seed:state copies a kept seeded state into this
      // run's own temp $state, so two renders never share one, and wrangler
      // dev serves both from that copy. A state is kept per digest of the
      // seed's inputs (src/, fixtures/, web/wrangler.jsonc, package.json,
      // pnpm-lock.yaml, the cached dump and the SEED_* settings), in the main
      // checkout's .data/seeded-states/. When any of them changes, the next
      // render runs seed:dev again and keeps that state
      // (src/import/seededStates.ts, #843).
      "prefix": "web/",
      "mount": "/",
      "readyPath": "/",
      "command": "state=$(mktemp -d \"${TMPDIR:-/tmp}/lexema-ui.XXXXXX\") && trap 'rm -rf \"$state\"' EXIT && pnpm run seed:state \"$state/state\" && pnpm --filter @lexema/web build && cd web && pnpm exec wrangler dev --config dist/server/wrangler.json --persist-to \"$state/state\" --port {{port}} --var LEXEMA_RELEASE:it-dev"
    }
  ],
  // What the lane runs to install dependencies and check a merged tree
  // (the same checks builders and reviewers run).
  "dependencyReconciler": { "command": ["pnpm", "install", "--frozen-lockfile"] },
  "codeValidators": [
    { "command": ["pnpm", "run", "typecheck"] },
    { "command": ["pnpm", "--filter", "@lexema/web", "typecheck"] },
    { "command": ["pnpm", "test"] }
  ],
  // `build check` runs lefthook's own validator on any diff that touches
  // lefthook.yml, so a hooks-only change can go green.
  "configValidators": [
    { "command": ["pnpm", "exec", "lefthook", "validate"], "reads": ["lefthook.yml"] },
    { "command": ["pnpm", "exec", "fabrika", "status", "settings", "--json"], "reads": [".fabrika.jsonc"] }
  ],
  // The main-went-red alarm mentions Huey.
  "ci": { "mainAlarm": { "mention": ["@hueypov"] } },
  "uiCapture": {
    "viewport": { "width": 1440, "height": 900 }
  },
  // Every park names its cause (#350). A park with no cause is refused
  // instead of recorded, because an uncaused park routes to Huey. A park
  // whose cause routes to the driver is cleared by the driver, not by Huey.
  "parkCause": { "uncaused": "refuse", "driverRouted": "clear" }
}
