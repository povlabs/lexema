{
  "$schema": "./.fabrika.schema.json",
  "uiSurfaces": [
    {
      "name": "web",
      "prefix": "web/",
      "mount": "/",
      "readyPath": "/",
      "command": "state=$(mktemp -d \"${TMPDIR:-/tmp}/lexema-ui.XXXXXX\") && trap 'rm -rf \"$state\"' EXIT && SEED_SQL=\"$state/dev.sql\" SEED_STATE=\"$state/state\" pnpm run seed:dev && pnpm --filter @lexema/web build && cd web && pnpm exec wrangler dev --config dist/server/wrangler.json --persist-to \"$state/state\" --port {{port}} --var LEXEMA_RELEASE:it-dev"
    }
  ],
  "uiCapture": {
    "viewport": { "width": 1440, "height": 900 }
  }
}
